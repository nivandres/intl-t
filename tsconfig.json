{
  "compilerOptions": {
    "allowArbitraryExtensions": true,
    "composite": true,
    "declaration": true,
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM"],
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "types": ["*"],
    "noImplicitThis": false,
    "paths": {
      "@intl-t/core": ["./packages/core/src"],
      "@intl-t/core/*": ["./packages/core/src/*"],
      "@intl-t/declarations": ["./packages/declarations/src"],
      "@intl-t/declarations/*": ["./packages/declarations/src/*"],
      "@intl-t/format": ["./packages/format/src"],
      "@intl-t/format/*": ["./packages/format/src/*"],
      "@intl-t/locales": ["./packages/locales/src"],
      "@intl-t/locales/*": ["./packages/locales/src/*"],
      "@intl-t/next": ["./packages/next/src"],
      "@intl-t/next/*": ["./packages/next/src/*"],
      "@intl-t/react": ["./packages/react/src"],
      "@intl-t/react/*": ["./packages/react/src/*"],
      "@intl-t/utils": ["./packages/utils/src"],
      "@intl-t/utils/*": ["./packages/utils/src/*"],
      "intl-t": ["./packages/core/src/index.ts"],
      "intl-t/*": ["./packages/core/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "apps", "examples"]
}
